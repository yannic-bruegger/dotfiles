{
    "layer": "top",
    "height": 25,
    "modules-left": ["hyprland/workspaces", "hyprland/window"], 
    "modules-center": ["clock", "custom/uair"],
    "modules-right": ["network", "bluetooth", "pulseaudio", "battery", "tray"],
    "custom/uair": {
        "exec": "~/.config/uair/uair-bar.sh",
        "format": " ({})",
        "on-click": "uairctl toggle",
        "on-click-right": "uairctl jump work",
        "on-scroll-up": "uairctl next",
        "on-scroll-down": "uairctl prev",
        "tooltip": false
    },
    "sway/window": {
        "max-length": 50
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": ["", "", "", "", ""]
    },
    "clock": {
        "format-alt": "{:%a, %d. %b  %H:%M}",
        "tooltip-format": "{:%a, %d. %b  %H:%M}"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 10
    },
    "network": {
        "format-wifi": "󰖩",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "on-click": "nm-connection-editor",
        "tooltip-format": "{ifname}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}",
        "tooltip-format-disconnected": "Disconnected"
    },
    "bluetooth": {
    	"format-on": "󰂯",
	"format-no-controller": "󰂲 not found",
        "format-connected": "󰂱",
        "format-disabled": "󰂲",
	"format-off": "󰂲",
        "on-click-right": "~/dotfiles/hyprland/toggle-blueman.sh",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
    },
    "pulseaudio": {
    	"format": "{volume}% {icon}",
	"format-bluetooth": "{volume}% {icon}",
	"format-muted": "",
	"format-icons": ["", "", ""],
	"reverse-scrolling": true
    }
}
